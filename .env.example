# Where the browser fetches the ONNX weights from.
#
# Unset / "model"  -> same origin (the site's own ./model/ folder).
# A URL            -> that absolute base, loaded cross-origin (needs CORS).
#
# In mainland China the default GitHub Pages origin is slow, so point this at a
# mirror of the repo's public/model/ directory. Verified working mirrors
# (all send `access-control-allow-origin: *` and support Range requests):
#
#   https://gh-proxy.com/https://raw.githubusercontent.com/yportne13/inflect-zh-en-tts/main/public/model
#   https://ghfast.top/https://raw.githubusercontent.com/yportne13/inflect-zh-en-tts/main/public/model
#   https://ghproxy.net/https://raw.githubusercontent.com/yportne13/inflect-zh-en-tts/main/public/model
#
# jsDelivr only works for files under 20 MB, so it cannot serve the 29 MB
# decode.onnx: https://cdn.jsdelivr.net/gh/<user>/<repo>@main/public/model
#
# If you forked this repo, replace yportne13/inflect-zh-en-tts with your own
# <user>/<repo> (and main with the branch you deploy).
VITE_MODEL_BASE=

# Where the ~28 MB ONNX Runtime Web WASM binary is loaded from.
#
# Unset            -> the copy Vite bundles into the site's own assets/ folder.
# A URL (dir)      -> that directory, which must contain the runtime files under
#                     their unhashed names (ort-wasm-simd-threaded.jsep.wasm /
#                     .mjs). Requires CORS.
#
# npmmirror serves the exact onnxruntime-web dist files from a China CDN with
# CORS enabled and a 1-year cache. Pin the path to the version in package.json:
#
#   https://registry.npmmirror.com/onnxruntime-web/1.30.0/files/dist
#
# jsDelivr cannot be used here: ort-wasm-simd-threaded.jsep.wasm is ~28 MB and
# jsDelivr rejects files over 20 MB.
VITE_ORT_BASE=
