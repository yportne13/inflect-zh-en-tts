# Production build pulls the ONNX weights from a GitHub mirror so the deployed
# site is usable on mainland-China networks. `npm run dev` ignores this file and
# keeps using the locally served ./model/ folder.
VITE_MODEL_BASE=https://gh-proxy.com/https://raw.githubusercontent.com/yportne13/inflect-zh-en-tts/main/public/model

# The ~28 MB ONNX Runtime WASM runtime is served from the npmmirror CDN. The
# path is pinned to the onnxruntime-web version in package.json, so bump it when
# that dependency is upgraded.
VITE_ORT_BASE=https://registry.npmmirror.com/onnxruntime-web/1.30.0/files/dist

# The ~4.6 MB English pronouncing dictionary is otherwise a code-split chunk
# served from this origin. Pinned to the cmu-pronouncing-dictionary version in
# package.json.
VITE_DICTIONARY_URL=https://cdn.jsdelivr.net/npm/cmu-pronouncing-dictionary@3.0.0/index.js
