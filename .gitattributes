# The English pronunciation lexicon is parsed line by line in the browser, so a
# CRLF checkout would put a stray \r inside every IPA value and make the whole
# English side emit unknown symbols. Force LF regardless of core.autocrlf.
public/en-lexicon.txt text eol=lf

# ONNX weights are opaque binaries. Without this, git's autocrlf or a
# text-tools misdetection can rewrite them and the graph silently stops loading,
# which is indistinguishable from a bad model.
*.onnx binary

# The compare page is generated by scripts/_gen_compare_page.py. With
# core.autocrlf=true a Windows checkout rewrites its LF endings to CRLF, and
# every regeneration then produces a diff of "one byte per line" against the
# copy GitHub Pages deployed (hit 2026-10-14: 15,878 vs 15,827 bytes, delta 51 =
# the line count). Pin the generator's output to LF everywhere.
public/compare/index.html text eol=lf
