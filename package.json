{
  "name": "inflect-zh-en-tts-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bilingual (Mandarin + English) TTS demo running fully in the browser with ONNX Runtime Web (WebGPU / WASM).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "check:frontend": "esbuild scripts/verify-frontend.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-frontend.cjs --log-level=warning && node node_modules/.cache/verify-frontend.cjs",
    "check:chunking": "esbuild scripts/check-chunking.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-chunking.cjs --log-level=warning && node node_modules/.cache/check-chunking.cjs",
    "check:onnx": "node scripts/check-onnx-fp16.mjs public/model"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0",
    "pinyin-pro": "^3.29.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
